# NAPIER AI Backend Configuration Template
PROJECT_NAME="NAPIER AI Engine"
PORT=8000

# Real-time fares (required for live pricing): https://serpapi.com
SERPAPI_KEY=""
SERPAPI_GL="in"

# Cache (TTL clamped to 1800-3600 s). Redis is preferred; otherwise Supabase `fare_cache`; otherwise in-process.
CACHE_TTL_SECONDS=2700
REDIS_URL=""

# Archive + index trends
SUPABASE_URL="https://your-supabase-project.supabase.co"
SUPABASE_KEY="your-supabase-anon-key"

# Comma-separated list of origins (or "*")
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,https://napier-frontend-phi.vercel.app,https://rkrworks.github.io"
